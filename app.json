{
  "expo": {
    "name": "AK Invoice",
    "slug": "ak-invoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ak-invoice",
    "userInterfaceStyle": "automatic",

    "icon": "./assets/images/icon.jpg",

    "splash": {
      "image": "./assets/images/splash-icon.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "android": {
      "package": "com.akplastic.invoice",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.jpg",
        "backgroundColor": "#ffffff"
      }
    },

    "web": {
      "favicon": "./assets/images/favicon.jpg"
    },

    "ios": {
      "bundleIdentifier": "com.akplastic.invoice"
    },

    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],

    "extra": {
      "eas": {
        "projectId": "df4be8ba-885f-4308-ac55-de5747792c37"
      }
    }
  }
}
